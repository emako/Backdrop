<Window
    x:Class="MicaDrop.WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MicaDrop WPF Demo"
    Width="980"
    Height="640"
    MinWidth="900"
    MinHeight="560"
    Background="Transparent"
    Loaded="Window_Loaded"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <!--<Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#14000000" Offset="0" />
                <GradientStop Color="#06000000" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>-->

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            x:Name="ControlsPanel"
            Margin="24"
            Padding="20"
            BorderThickness="1"
            CornerRadius="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="MicaDrop" />

                <TextBlock
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    Opacity="0.78"
                    Text="用下拉框切换背景、圆角和 Acrylic 颜色，直接观察当前系统下的实际效果。"
                    TextWrapping="Wrap" />

                <StackPanel Grid.Row="2" Margin="0,24,0,0">
                    <TextBlock
                        Margin="0,0,0,8"
                        FontWeight="SemiBold"
                        Text="Backdrop" />
                    <ComboBox
                        x:Name="BackdropComboBox"
                        MinHeight="34"
                        SelectionChanged="SelectionChanged_Reapply" />
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,18,0,0">
                    <TextBlock
                        Margin="0,0,0,8"
                        FontWeight="SemiBold"
                        Text="Corner" />
                    <ComboBox
                        x:Name="CornerComboBox"
                        MinHeight="34"
                        SelectionChanged="SelectionChanged_Reapply" />
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,18,0,0">
                    <TextBlock
                        Margin="0,0,0,8"
                        FontWeight="SemiBold"
                        Text="Acrylic Tint" />
                    <ComboBox
                        x:Name="AcrylicColorComboBox"
                        MinHeight="34"
                        DisplayMemberPath="Name"
                        SelectionChanged="SelectionChanged_Reapply" />
                </StackPanel>

                <CheckBox
                    x:Name="DarkModeCheckBox"
                    Grid.Row="5"
                    Margin="0,18,0,0"
                    Checked="DarkModeCheckBox_Changed"
                    Content="应用沉浸式深色标题栏"
                    Unchecked="DarkModeCheckBox_Changed" />

                <Border
                    Grid.Row="6"
                    Margin="0,22,0,0"
                    Padding="14"
                    Background="#1A000000"
                    CornerRadius="12">
                    <TextBlock
                        x:Name="StatusTextBlock"
                        FontFamily="Consolas"
                        FontSize="13"
                        TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="0,24,24,24">
            <Border
                x:Name="PreviewCard"
                MaxWidth="560"
                Padding="28"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                BorderThickness="1"
                CornerRadius="24">
                <StackPanel>
                    <TextBlock
                        FontSize="32"
                        FontWeight="SemiBold"
                        Text="Effect Preview" />
                    <TextBlock
                        Margin="0,12,0,0"
                        Opacity="0.8"
                        Text="当前窗口会直接套用 MicaDrop 效果。左侧组合框用于切换效果，右侧区域仅作为前景内容，方便观察背景与边框变化。"
                        TextWrapping="Wrap" />

                    <UniformGrid
                        Margin="0,28,0,0"
                        Columns="2"
                        Rows="2">
                        <Border
                            Margin="0,0,12,12"
                            Padding="16"
                            Background="#22FFFFFF"
                            CornerRadius="16">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="OS" />
                                <TextBlock x:Name="OsVersionTextBlock" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border
                            Margin="0,0,0,12"
                            Padding="16"
                            Background="#22FFFFFF"
                            CornerRadius="16">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Supported" />
                                <TextBlock x:Name="SupportedTextBlock" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border
                            Margin="0,0,12,0"
                            Padding="16"
                            Background="#22FFFFFF"
                            CornerRadius="16">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Selected" />
                                <TextBlock
                                    x:Name="SelectedTextBlock"
                                    Margin="0,6,0,0"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border
                            Margin="0,0,0,0"
                            Padding="16"
                            Background="#22FFFFFF"
                            CornerRadius="16">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Acrylic Color" />
                                <TextBlock x:Name="AcrylicColorTextBlock" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>