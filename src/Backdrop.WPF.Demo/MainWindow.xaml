<Window
    x:Class="Backdrop.WPF.Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="MicaDrop WPF Demo"
    Width="980"
    Height="640"
    MinWidth="900"
    MinHeight="560"
    x:ClassModifier="internal"
    Background="Transparent"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Foreground" Value="White" />
            </Style.Setters>
        </Style>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="32"
            CornerRadius="18"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Margin="24"
            Padding="20"
            BorderThickness="1"
            CornerRadius="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="Backdrop" />

                <TextBlock
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    Opacity="0.78"
                    Text="用下拉框切换背景、圆角，直接观察当前系统下的实际效果。"
                    TextWrapping="Wrap" />

                <StackPanel Grid.Row="2" Margin="0,24,0,0">
                    <TextBlock
                        Margin="0,0,0,8"
                        FontWeight="SemiBold"
                        Text="Backdrop" />
                    <ComboBox
                        x:Name="BackdropComboBox"
                        MinHeight="34"
                        ItemsSource="{Binding BackdropOptions}"
                        SelectedItem="{Binding SelectedBackdrop, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,18,0,0">
                    <TextBlock
                        Margin="0,0,0,8"
                        FontWeight="SemiBold"
                        Text="Corner" />
                    <ComboBox
                        x:Name="CornerComboBox"
                        MinHeight="34"
                        ItemsSource="{Binding CornerOptions}"
                        SelectedItem="{Binding SelectedCorner, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Row="5" Margin="0,18,0,0">
                    <TextBlock
                        Margin="0,0,0,8"
                        FontWeight="SemiBold"
                        Text="Theme" />
                    <ComboBox
                        x:Name="ThemeComboBox"
                        MinHeight="34"
                        ItemsSource="{Binding DarkModeOptions}"
                        SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="0,24,24,24">
            <Border
                MaxWidth="560"
                Padding="28"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                BorderThickness="1"
                CornerRadius="24">
                <StackPanel>
                    <TextBlock
                        FontSize="32"
                        FontWeight="SemiBold"
                        Text="Effect Preview" />
                    <TextBlock
                        Margin="0,12,0,0"
                        Opacity="0.8"
                        Text="当前窗口会直接套用 Backdrop 效果。左侧组合框用于切换效果，右侧区域仅作为前景内容，方便观察背景与边框变化。"
                        TextWrapping="Wrap" />

                    <UniformGrid
                        Margin="0,28,0,0"
                        Columns="2"
                        Rows="2">
                        <Border
                            Margin="0,0,12,12"
                            Padding="16"
                            Background="#22FFFFFF"
                            CornerRadius="16">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="OS" />
                                <TextBlock Margin="0,6,0,0" Text="{Binding OsVersion}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Margin="0,0,0,12"
                            Padding="16"
                            Background="#22FFFFFF"
                            CornerRadius="16">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Supported" />
                                <TextBlock Margin="0,6,0,0" Text="{Binding Supported}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Margin="0,0,12,0"
                            Padding="16"
                            Background="#22FFFFFF"
                            CornerRadius="16">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Selected" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Text="{Binding Selected}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>